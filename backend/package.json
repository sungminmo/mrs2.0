{
  "name": "mrs-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "npm run db:generate && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc",
    "start": "node dist/src/index.js",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "hono": "4.13.7",
    "prisma": "7.10.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@prisma/adapter-mariadb": {
      "mariadb": "3.5.4"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
