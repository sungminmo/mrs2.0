/// 마켓 상품 운영 상태: 판매대기 -> 판매 중 -> 재고 없음
/// 판매취소는 별도 상태가 아니라 DRAFT로 되돌리는 운영 액션이다.
enum ProductStatus {
  DRAFT        @map("판매대기")
  AVAILABLE    @map("판매중")
  OUT_OF_STOCK @map("재고없음")
}

model SaleRequest {
  id            String   @id @db.VarChar(36)
  assetId       String   @unique @db.VarChar(11)
  actorUserId   String   @db.VarChar(36)
  quantity      Decimal  @db.Decimal(18, 3)
  desiredAmount Decimal  @db.Decimal(19, 0)
  status        String   @default("PENDING") @db.VarChar(20)
  inspection    String   @default("PENDING") @db.VarChar(20)
  createdAt     DateTime @default(now())
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, createdAt])
  @@map("sale_requests")
}

/// 마켓 상품 또는 기획전 변경 이력의 대상 유형
enum MarketEntityType {
  PRODUCT
  CAMPAIGN
}

/// 자산 단위 판매 상품. 한 자산은 하나의 상품으로만 등록할 수 있다.
model Product {
  id                   String              @id @db.VarChar(20)
  assetId              String              @unique @db.VarChar(11)
  name                 String              @db.VarChar(160) // 마켓 노출 상품명 스냅샷
  originalUnitPrice    Decimal             @db.Decimal(19, 0) // 할인 전 단가, 원 단위·VAT 포함
  discountRate         Int                 @default(0) @db.UnsignedTinyInt // 0~100 정수
  listedQuantity       Decimal             @db.Decimal(18, 3) // 판매 등록 수량
  reservedQuantity     Decimal             @default(0) @db.Decimal(18, 3) // 진행 중 구매 요청에 예약된 수량
  soldQuantity         Decimal             @default(0) @db.Decimal(18, 3) // 출고 확정된 누적 수량
  minimumOrderQuantity Decimal             @default(1) @db.Decimal(18, 3)
  deliveryNotice       String              @default("") @db.VarChar(1000)
  status               ProductStatus       @default(DRAFT)
  publishedAt          DateTime? // 최초 판매 중 전환 시각
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cartItems CartItem[]
  /// 접수 당시 정보를 보존하는 구매 견적 상품 스냅샷.
  quoteItems PurchaseQuoteItem[]
  /// 확정 회신 상품 참조. 회신 자체는 재고를 예약하지 않는다.
  offerItems QuoteOfferItem[]
  /// 고객 승인 거래의 예약 및 출고 대상.
  orderItems PurchaseOrderItem[]
  /// 상품을 직접 선택해 편성한 기획전 연결. 여러 기획전에 중복 편성 가능하다.
  campaignItems CampaignProduct[]

  @@index([status, createdAt])
  @@map("products")
}

/// 직접 상품 편성 기획전. 기간 내 판매 가능한 편성 상품만 고객에게 노출한다.
model Campaign {
  /// 서버가 생성하는 변경 불가 기획전 번호.
  id          String   @id @db.VarChar(20)
  /// 고객 마켓에 표시하는 기획전 제목.
  name        String   @db.VarChar(120)
  /// 고객 화면의 배너 등록 영역을 식별하는 3자리 텍스트 코드.
  placementCode String @default("MKT") @db.VarChar(3)
  /// 관리자가 등록 위치를 인식하기 위한 영역 설명명.
  placementName String @default("고객포탈 마켓 상단 기획전") @db.VarChar(120)
  /// 고객에게 표시하는 설명.
  description String   @db.VarChar(1000)
  /// 노출 사용 여부. 빈 편성은 사용 설정 불가하다.
  enabled     Boolean  @default(false)
  /// 기획전 간 노출 순서. 작은 값이 먼저 표시된다.
  sortOrder   Int      @default(0) @db.UnsignedSmallInt
  /// 노출 시작 시각(포함), UTC 저장.
  startsAt    DateTime
  /// 노출 종료 시각(미포함), UTC 저장.
  endsAt      DateTime
  /// 동시 편집 충돌 검사용 버전. 저장마다 증가한다.
  version     Int      @default(0)
  /// 최초 등록 시각.
  createdAt   DateTime @default(now())
  /// 마지막 저장 시각.
  updatedAt   DateTime @updatedAt

  /// 최대 100종의 직접 편성 상품과 표시 순서.
  items CampaignProduct[]

  /// 노출 대상 기획전 기간 및 순서 조회용 인덱스.
  @@index([enabled, startsAt, endsAt, sortOrder])
  /// 영역별 노출 대상 및 순서 조회용 인덱스.
  @@index([placementCode, enabled, sortOrder])
  @@map("campaigns")
}

/// 기획전 상품 편성. 판매 중단 시에도 연결을 보존해 판매 재개 시 다시 노출한다.
model CampaignProduct {
  /// 편성 대상 기획전 번호.
  campaignId String @db.VarChar(20)
  /// 선택한 실제 상품 번호.
  productId String @db.VarChar(20)
  /// 기획전 내 표시 순서. 0부터 시작하며 중복을 허용하지 않는다.
  sortOrder Int @db.UnsignedSmallInt
  /// 기획전 삭제 시 편성 연결만 삭제한다.
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// 편성 중 상품 삭제를 차단한다. 재고와 가격은 현재 상품 값을 조회한다.
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// 한 기획전에 동일 상품은 한 번만 편성 가능하다.
  @@id([campaignId, productId])
  /// 기획전 내 순서 중복 방지.
  @@unique([campaignId, sortOrder])
  /// 상품별 기획전 연결 조회용 인덱스.
  @@index([productId])
  @@map("campaign_products")
}

/// 상품·기획전 운영 변경 감사 이력. 다형 대상은 entityType/entityId로 식별한다.
model MarketChange {
  id          String           @id @db.VarChar(36)
  entityType  MarketEntityType
  entityId    String           @db.VarChar(20)
  actorUserId String?          @db.VarChar(36) // 시스템 변경은 null
  reason      String           @db.VarChar(500)
  changes     Json // 필드별 before/after 값
  createdAt   DateTime         @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("market_changes")
}
