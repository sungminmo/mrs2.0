/// 계정 유형: 고객(자산 소유주) / 관리자
enum UserRole {
  CUSTOMER
  ADMIN
}

enum AdminRole {
  SYSTEM_ADMIN
  ADMIN
  SALES
  LOGISTICS
}

/// 가입 승인 흐름: 대기 -> 승인/반려, 승인 후 정지 가능
enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

/// 서비스 이용 계정(고객사 담당자 또는 관리자)
model User {
  id           String     @id @default(uuid()) @db.VarChar(36)
  customerId   String?    @db.VarChar(20) // 기존 자산 소유 고객 코드. 같은 고객사에 여러 계정 연결 가능
  customerRole CustomerRole @default(VIEWER)
  sessionVersion Int      @default(0)
  email        String     @unique @db.VarChar(254)
  passwordHash String     @db.VarChar(255) // 해시 저장, 평문 비밀번호는 저장하지 않음
  companyName  String     @db.VarChar(160)
  companyPhone String?    @db.VarChar(30)
  managerName  String     @db.VarChar(80) // 담당자 이름
  managerPhone String     @db.VarChar(30) // 담당자 연락처
  address      String?    @db.VarChar(500)
  role         UserRole   @default(CUSTOMER)
  adminRole    AdminRole?
  status       UserStatus @default(PENDING) // 가입 직후 관리자 승인 대기 상태
  approvedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  marketChanges    MarketChange[]
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerApplication CustomerApplication?
  customerChanges CustomerChange[] @relation("CustomerChangeActor")
  membershipChanges CustomerChange[] @relation("CustomerChangeTarget")
  inspections      Inspection[]
  disposalComments DisposalComment[]
  receivingChanges ReceivingChange[]
  cart Cart?
  /// 개인별 알림 읽음 기록. 회사 변경 시 이전 회사 알림은 조회하지 않는다.
  notificationReads NotificationRead[]
  /// 계정이 제출한 구매 견적 요청. 조회는 고객사 단위로 공유한다.
  purchaseQuotes PurchaseQuote[]
  /// 확정 견적 작성 행위.
  createdOffers QuoteOffer[] @relation("OfferCreator")
  /// 확정 견적 회신 행위.
  sentOffers QuoteOffer[] @relation("OfferSender")
  /// 고객 MANAGER의 거래 승인 행위.
  approvedOrders PurchaseOrder[] @relation("OrderApprover")
  /// 출고 초안 작성 행위.
  createdShipments Shipment[] @relation("ShipmentCreator")
  /// 출고 확정 행위.
  dispatchedShipments Shipment[] @relation("ShipmentDispatcher")
  /// 배송 완료 처리 행위.
  deliveredShipments Shipment[] @relation("ShipmentDeliverer")
  /// 고객 또는 관리자의 잔여 취소 요청.
  requestedCancellations OrderCancellation[] @relation("CancellationRequester")
  /// 관리자의 취소 결정.
  decidedCancellations OrderCancellation[] @relation("CancellationDecider")
  /// 거래 업무 감사 이력.
  fulfillmentChanges FulfillmentChange[] @relation("FulfillmentActor")
  /// 거래 업무 멱등성 영수증.
  fulfillmentOperations FulfillmentOperation[] @relation("FulfillmentOperator")

  @@index([customerId])
  @@index([status, createdAt]) // 승인 대기 목록 등 상태별 조회
  @@map("users")
}